{
    "name": "reactiph/wordpress-bridge",
    "description": "WordPress BridgeInterface implementation for Reactiph: asset serving and an RPC endpoint via the WP REST API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "reactiph/reactiph": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "Reactiph\\WordPressBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reactiph\\WordPressBridge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs-check"
        ]
    },
    "minimum-stability": "stable"
}
