{
    "name": "reactiph/reactiph",
    "description": "A Viewi-style reactive PHP component framework: server-rendered, transpiled to JS for client-side reactivity.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Reactiph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Reactiph\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs-check"
        ]
    },
    "minimum-stability": "stable"
}
